# WhatsApp Cloud API (Meta Graph API)
# Demo only: EXPO_PUBLIC_* values are inlined into the client bundle.
# Production should send via a backend proxy and keep the access token server-side.

EXPO_PUBLIC_WHATSAPP_ACCESS_TOKEN=
EXPO_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=
EXPO_PUBLIC_WHATSAPP_GRAPH_API_VERSION=v21.0
