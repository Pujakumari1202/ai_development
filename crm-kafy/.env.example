# Expo client (use your computer's LAN IP instead of localhost on a device)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_USE_LOCAL_DATA=false

# API and PostgreSQL
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_kafy
CORS_ORIGIN=*
ALLOW_DB_RESET=true

# Set false in production and configure the Keycloak realm issuer/client.
AUTH_DISABLED=true
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=

# Meta WhatsApp Cloud API — server-side only, never EXPO_PUBLIC_*
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
